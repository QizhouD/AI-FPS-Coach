# Copy to ".env" in the repo root, or let Backend/setup-vision.ps1 write it.
# Used by Backend/run-vision.ps1. Do not commit ".env".

FPS_VISION_ENEMY_MODEL_PATH=
FPS_VISION_CROSSHAIR_MODEL_PATH=
FPS_VISION_CROSSHAIR_BASELINE=true
FPS_VISION_DEVICE=cuda
FPS_VISION_CONFIDENCE=0.25

# Inference resolution. Leave empty to infer at the footage's own long side,
# which is what you want. Ultralytics otherwise defaults to 640, and letterboxing
# 1080p down to that leaves a head about 3 px across, below the network's finest
# 8 px stride, so heads stop being detected at all. Measured on range footage:
# 640 found a head on 15% of boxed players, native 1920 on 66%, at no extra cost
# in time. Set a number here only to reproduce an older measurement.
FPS_VISION_IMGSZ=

# Only videos inside this directory can be analysed. Point OBS's recording
# output here, otherwise POST /api/v1/vision/video returns 400.
FPS_VISION_MEDIA_ROOT=

# Where analysed sessions are written. Defaults to "data" beside the repo root.
FPS_VISION_DATA_ROOT=

# The in-game FOV, which Source defines as horizontal at 4:3. Deviations cannot
# be converted to degrees without it, and a wrong value scales every metric.
FPS_VISION_FOV_DEG=90

# How long a finished job stays addressable in memory. Results are on disk by
# then, so eviction only costs a slower re-read.
FPS_VISION_JOB_TTL_SECONDS=3600
