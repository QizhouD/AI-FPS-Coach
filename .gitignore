# Unity generated directories
**/[Ll]ibrary/
**/[Tt]emp/
**/[Oo]bj/
**/[Ll]ogs/
**/[Uu]ser[Ss]ettings/
**/[Mm]emoryCaptures/
**/[Rr]ecordings/

# Unity build output
/Builds/
**/[Bb]uild/
**/[Bb]uilds/
**/[Bb]uildOutput/
**/[Bb]urstDebugInformation_DoNotShip/
**/[Ii]l2[Cc]ppBuildCache/

# Unity generated files
*.csproj
*.sln
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db
*.pidb.meta
*.pdb.meta
*.mdb.meta
sysinfo.txt
crashlytics-build.properties

# Unity packages and generated exports
*.unitypackage
*.apk
*.aab
*.app
*.exe

# Python environments and caches
**/.venv/
**/venv/
**/env/
**/__pycache__/
*.py[cod]
*.pyo
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
coverage.xml
htmlcov/

# Chinese design notes and runbooks, kept local on purpose
/doc/

# Local environment and secrets
.env
.env.*
!.env.example
*.pem
*.key

# IDE and editor settings
.idea/
.vs/
.vscode/
*.swp
*.swo

# Generated by `unity skill install cursor --local`; re-create with that command
/.cursor/rules/unity-cli.mdc

# Written by `unity mcp configure cursor --local`; pins this machine's project path
/.cursor/mcp.json

# Operating system files
.DS_Store
Thumbs.db
Desktop.ini

# Editor and play-mode captures: local verification artifacts, not project source.
# The folder meta is ignored too, so a fresh clone has no meta for a missing folder.
**/[Ss]creenshots/
**/[Ss]creenshots.meta

# Local match data and captured media
/demo/
# Where ClipRecorder writes clips, plus its rolling-buffer scratch segments. Listed as a folder as
# well as by extension so the scratch subfolder never shows up as untracked either.
/genVedio/
*.dem
*.mp4
*.mov
*.m4v
*.avi
*.webm

# One curated exception: the short README clip. Everything else matching the
# patterns above is practice footage and stays out of the repository.
!/docs/assets/war-room.mp4

# Machine-learning weights and runtime engines
*.pt
*.pth
*.onnx
*.engine
*.weights
# Hugging Face leaves a blob cache beside the weights it downloads.
/models/.cache/

# Analysed sessions and accuracy reports. Local measurements, regenerated by
# re-running the analysis, and a round of frames is megabytes of JSON.
# Unanchored: the data root follows the working directory when
# FPS_VISION_DATA_ROOT is unset, so it can land under Backend/ too.
data/
reports/
media/

# Temporary and local diagnostic output
*.log
*.tmp
*.bak
*.cache
